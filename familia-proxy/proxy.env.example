# /etc/familIA/proxy.env  (root:root, mode 600). Real values live only on the Pi.
# Variables read by ovos_openai_proxy.py (see its docstring).

# Full /ask URL of the familIA API Gateway (required)
FAMILIA_API_URL=https://xxxx.execute-api.eu-central-1.amazonaws.com/prod/ask
AWS_REGION=eu-central-1

# AWS credentials of the familia-pi-client IAM user (familIA repo:
# scripts/create_pi_credentials.sh). Used only to SigV4-sign /ask calls.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bearer key OVOS and Open WebUI must send; same value as FAMILIA_PROXY_API_KEY in setup.env
PROXY_API_KEY=

# Keep the proxy loopback-only: only OVOS and Open WebUI on this Pi call it.
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
MODEL_NAME=familia

# Optional: home-mcp tools (https://github.com/mahdsip/home-mcp), reached over SSH
# with a forced-command key; no network port is opened. See home-mcp
# deploy/authorize_proxy_key.sh for creating the key on the MCP host.
# MCP_SERVER_COMMAND=ssh -F none -T -o BatchMode=yes -i /etc/familIA/mcp_ed25519 -o UserKnownHostsFile=/etc/familIA/mcp_known_hosts -o StrictHostKeyChecking=yes familia-mcp@<mcp-host>
# MAX_TOOL_ROUNDS=3
# LOG_LEVEL=INFO
