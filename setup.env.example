# Copy to setup.env (git-ignored), fill in, then run ./install/apply.sh on the Pi.
# Every value below is substituted into the files of this repo at install time;
# no secret is ever committed.

# --- Host ---------------------------------------------------------------------
# Login user OVOS runs as (the ovos-installer user)
OVOS_USER=

# --- Network exposure -------------------------------------------------------
# Address the LAN-facing services bind to: HiveMind core (5678), HiveMind
# webchat (9090) and Open WebUI (3000). Loopback by default, so nothing is
# reachable from other machines until you decide otherwise. To use them from
# phones/PCs on the home network set the Pi's LAN IP (e.g. 192.168.1.50) and
# reserve that IP on the router: the services fail to start if the IP changes.
BIND_IP=127.0.0.1

# --- OVOS skills --------------------------------------------------------------
# Home Assistant base URL, e.g. http://homeassistant.local:8123
HA_URL=
# Home Assistant long-lived access token (Profile -> Security -> Long-lived tokens)
HA_TOKEN=
# Plex server URL, e.g. http://<plex-ip>:32400
PLEX_URL=
# Plex token (X-Plex-Token) for ovos-skill-plex
PLEX_TOKEN=

# --- familIA proxy (OVOS / Open WebUI -> API Gateway /ask) ---------------------
# Bearer key OVOS's persona and Open WebUI send to the local proxy (127.0.0.1:8080).
# Any random string; it must match PROXY_API_KEY in /etc/familIA/proxy.env.
FAMILIA_PROXY_API_KEY=

# --- Open WebUI ---------------------------------------------------------------
# Session-signing secret. Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=
