[Unit]
Documentation=https://openvoiceos.github.io/ovos-docker/about/glossary/components/#ovos-phal
Description=Open Voice OS - PHAL
PartOf=ovos.service
Requires=ovos.service ovos-messagebus.service
After=ovos.service ovos-messagebus.service
Wants=sound.target
After=sound.target

[Service]
User=__OVOS_USER__
Group=__OVOS_USER__
Environment=HOME=/home/__OVOS_USER__
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
EnvironmentFile=-/home/__OVOS_USER__/.config/environment.d/99-ovos-tuning.conf
ExecStartPre=/bin/bash -c 'for _ovos_retry in {1..30}; do [ -S /run/user/1000/pipewire-0 ] && exit 0; sleep 1; done; echo "PipeWire socket unavailable: /run/user/1000/pipewire-0" >&2; exit 1'
WorkingDirectory=/home/__OVOS_USER__/.venvs/ovos
ExecStart=/home/__OVOS_USER__/.venvs/ovos/bin/ovos_PHAL
ExecReload=/usr/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=ovos.service
