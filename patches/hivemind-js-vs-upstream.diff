+// Per-browser session id, kept across reloads. HiveMind 4 rejects messages
+// from non-admin clients that fall back to the shared "default" session.
+function webchatSessionId() {
+    let sid = localStorage.getItem("hivemind_webchat_session");
+    if (!sid) {
+        sid = "webchat-" + Array.from(crypto.getRandomValues(new Uint8Array(8)),
+            b => b.toString(16).padStart(2, "0")).join("");
+        localStorage.setItem("hivemind_webchat_session", sid);
+    }
+    return sid;
+}
 
